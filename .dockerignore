# Default-deny the build context. Re-include only files used by Dockerfile-nbgrader.
*

!Dockerfile-nbgrader
!docker_nbgrader_config.py
!docker_jupyter_server_config.py
!disable_teacher_extensions.sh

!logo/
!logo/**

!nbgrader/
!nbgrader/**

!jupyterlab/
!jupyterlab/**

!jupyterlab-thermal-design/
!jupyterlab-thermal-design/**

!jupyterlab-simulation-platform/
!jupyterlab-simulation-platform/**

!jupyterlab-param-binding/
!jupyterlab-param-binding/**

!jupyterlab-official-thermal-examples/
!jupyterlab-official-thermal-examples/**

!jupyterlab-training-platform/
!jupyterlab-training-platform/**

# Never send local dependency installs or package-manager caches.
**/node_modules
**/node_modules/**
**/.yarn/cache
**/.yarn/cache/**
**/.yarn/install-state.gz
**/.pnp.*

# VCS/editor/local agent state.
.git
.git/**
.agents
.agents/**
.codex
.vscode
.vscode/**
**/.git
**/.git/**
**/.github
**/.github/**
**/.vscode
**/.vscode/**

# Python and Jupyter runtime artifacts.
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/.ipynb_checkpoints
**/.ipynb_checkpoints/**

# Local outputs and generated development artifacts that are rebuilt in Docker.
jupyterlab-thermal-design/tests
jupyterlab-thermal-design/tests/**
jupyterlab-thermal-design/lib
jupyterlab-thermal-design/lib/**
jupyterlab-thermal-design/src/jupyterlab_thermal_design.egg-info
jupyterlab-thermal-design/src/jupyterlab_thermal_design.egg-info/**
jupyterlab-thermal-design/jupyterlab_thermal_design.egg-info
jupyterlab-thermal-design/jupyterlab_thermal_design.egg-info/**
jupyterlab-thermal-design/仿真结果归档
jupyterlab-thermal-design/仿真结果归档/**
jupyterlab-simulation-platform/lib
jupyterlab-simulation-platform/lib/**
jupyterlab-simulation-platform/jupyterlab_simulation_platform/labextension
jupyterlab-simulation-platform/jupyterlab_simulation_platform/labextension/**
jupyterlab-simulation-platform/simulation-platform-results
jupyterlab-simulation-platform/simulation-platform-results/**
jupyterlab-param-binding/lib
jupyterlab-param-binding/lib/**
jupyterlab-param-binding/jupyterlab_param_binding/labextension
jupyterlab-param-binding/jupyterlab_param_binding/labextension/**
jupyterlab-official-thermal-examples/lib
jupyterlab-official-thermal-examples/lib/**
jupyterlab-official-thermal-examples/jupyterlab_official_thermal_examples/labextension
jupyterlab-official-thermal-examples/jupyterlab_official_thermal_examples/labextension/**
jupyterlab-training-platform/lib
jupyterlab-training-platform/lib/**
jupyterlab-training-platform/jupyterlab_training_platform/labextension
jupyterlab-training-platform/jupyterlab_training_platform/labextension/**

# Runtime course/user data is mounted or created outside the image.
courses
courses/**
course_test
course_test/**

# Logs and local databases.
**/*.log
**/*.db
**/*.sqlite
**/*.sqlite3
