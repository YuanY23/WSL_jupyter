# ============================================================
# Dockerfile for Custom JupyterLab + nbgrader
# ============================================================
FROM jupyter/base-notebook:ubuntu-22.04

USER root

# Install required system packages
RUN apt-get update && apt-get install -yq --no-install-recommends \
    ca-certificates \
    curl \
    git \
    nodejs \
    npm \
    fonts-wqy-zenhei \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create exchange directory placeholder (will be overwritten by volume mount)
RUN mkdir -p /srv/nbgrader/exchange && \
    chmod 777 /srv/nbgrader/exchange

# Setup global nbgrader config
RUN mkdir -p /etc/jupyter
COPY docker_nbgrader_config.py /etc/jupyter/nbgrader_config.py
COPY docker_jupyter_server_config.py /etc/jupyter/jupyter_server_config.py

# Startup hook: dynamically disable teacher-only labextensions for students
COPY disable_teacher_extensions.sh /usr/local/bin/before-notebook.d/disable_teacher_extensions.sh
RUN chmod +x /usr/local/bin/before-notebook.d/disable_teacher_extensions.sh

ARG JULIA_VERSION=1.12.6
ARG JULIA_MAJOR_MINOR=1.12
ENV JULIA_DEPOT_PATH=/opt/julia-depot \
    JULIA_PKG_PRECOMPILE_AUTO=0

# Install the official Julia binary and keep the package depot outside
# /home/jovyan because JupyterHub mounts user homes over that path.
RUN curl -fsSL \
      "https://julialang-s3.julialang.org/bin/linux/x64/${JULIA_MAJOR_MINOR}/julia-${JULIA_VERSION}-linux-x86_64.tar.gz" \
      -o /tmp/julia.tar.gz && \
    mkdir -p /opt/julia /opt/julia-depot /opt/conda/share/jupyter && \
    tar -xzf /tmp/julia.tar.gz -C /opt/julia --strip-components=1 && \
    ln -s /opt/julia/bin/julia /usr/local/bin/julia && \
    rm /tmp/julia.tar.gz && \
    chown -R $NB_UID:$NB_GID /opt/julia /opt/julia-depot /opt/conda/share/jupyter && \
    julia --version

USER $NB_UID

ENV PIP_TRUSTED_HOST=mirrors.aliyun.com
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_EXTRA_INDEX_URL=https://pypi.org/simple
ARG PIP_DEFAULT_TIMEOUT=300
ARG PIP_RETRIES=20

# Install backend dependencies for nbgrader and custom authenticator.
# Use PyPI wheels to avoid slow conda solving and GUI packages such as pyside6.
RUN pip install --no-cache-dir \
    --index-url "$PIP_INDEX_URL" \
    --extra-index-url "$PIP_EXTRA_INDEX_URL" \
    --timeout 120 \
    --retries 10 \
    'jupyterlab==4.2.7' \
    'notebook==7.2.2' \
    'jupyter_server==2.14.2' \
    'alembic' \
    'sqlalchemy' \
    'traitlets' \
    'tornado' \
    'pytest' \
    'jupyterhub' \
    'rapidfuzz' \
    'requests' \
    'matplotlib' \
    'numpy' \
    'scipy' \
    'numba'

# Install IJulia globally so every spawned user server can select Julia.
RUN JUPYTER_DATA_DIR=/opt/conda/share/jupyter julia -e 'using Pkg; Pkg.add("IJulia"); Pkg.build("IJulia")' && \
    jupyter kernelspec list | grep -E "julia-1\\.12|julia"

# Install Chinese language pack for JupyterLab
RUN pip install --no-cache-dir \
    --index-url "$PIP_INDEX_URL" \
    --extra-index-url "$PIP_EXTRA_INDEX_URL" \
    --timeout 120 \
    --retries 10 \
    jupyterlab-language-pack-zh-CN

# Install Python build helpers before source COPY so this layer is reusable.
RUN pip install --no-cache-dir \
    --index-url "$PIP_INDEX_URL" \
    --extra-index-url "$PIP_EXTRA_INDEX_URL" \
    --timeout 120 \
    --retries 10 \
    'hatchling>=1.21.1' \
    'hatch-jupyter-builder>=0.7' \
    'editables>=0.5'

# Make sure lab extensions are enabled
RUN mkdir -p /opt/conda/etc/jupyter/jupyter_server_config.d && \
    echo '{"ServerApp":{"tornado_settings":{"headers":{"Content-Security-Policy":"frame-ancestors '"'"'self'"'"' * *"}}}}' > /opt/conda/etc/jupyter/jupyter_server_config.d/csp.json

# Pre-install custom extension dependencies from stable metadata/package files.
# Full source is copied later so TypeScript/CSS-only edits can reuse these layers.
COPY --chown=$NB_UID:$NB_GID jupyterlab-thermal-design/setup.py \
    jupyterlab-thermal-design/package.json \
    jupyterlab-thermal-design/yarn.lock \
    jupyterlab-thermal-design/.yarnrc.yml \
    /src/jupyterlab-thermal-design/
COPY --chown=$NB_UID:$NB_GID jupyterlab-thermal-design/jupyterlab_thermal_design/__init__.py /src/jupyterlab-thermal-design/jupyterlab_thermal_design/__init__.py
COPY --chown=$NB_UID:$NB_GID jupyterlab-thermal-design/thermal_solver /src/jupyterlab-thermal-design/thermal_solver
WORKDIR /src/jupyterlab-thermal-design
RUN pip install \
    --index-url "$PIP_INDEX_URL" \
    --extra-index-url "$PIP_EXTRA_INDEX_URL" \
    --timeout "$PIP_DEFAULT_TIMEOUT" \
    --retries "$PIP_RETRIES" \
    --no-build-isolation \
    -e .
RUN jlpm install

COPY --chown=$NB_UID:$NB_GID jupyterlab-simulation-platform/setup.py \
    jupyterlab-simulation-platform/package.json \
    jupyterlab-simulation-platform/yarn.lock \
    jupyterlab-simulation-platform/.yarnrc.yml \
    /src/jupyterlab-simulation-platform/
COPY --chown=$NB_UID:$NB_GID jupyterlab-simulation-platform/jupyterlab_simulation_platform/__init__.py /src/jupyterlab-simulation-platform/jupyterlab_simulation_platform/__init__.py
WORKDIR /src/jupyterlab-simulation-platform
RUN pip install \
    --index-url "$PIP_INDEX_URL" \
    --extra-index-url "$PIP_EXTRA_INDEX_URL" \
    --timeout "$PIP_DEFAULT_TIMEOUT" \
    --retries "$PIP_RETRIES" \
    --no-build-isolation \
    -e .
RUN jlpm install

COPY --chown=$NB_UID:$NB_GID jupyterlab-param-binding/setup.py \
    jupyterlab-param-binding/package.json \
    jupyterlab-param-binding/.yarnrc.yml \
    /src/jupyterlab-param-binding/
COPY --chown=$NB_UID:$NB_GID jupyterlab-param-binding/jupyterlab_param_binding/__init__.py /src/jupyterlab-param-binding/jupyterlab_param_binding/__init__.py
WORKDIR /src/jupyterlab-param-binding
RUN pip install \
    --index-url "$PIP_INDEX_URL" \
    --extra-index-url "$PIP_EXTRA_INDEX_URL" \
    --timeout "$PIP_DEFAULT_TIMEOUT" \
    --retries "$PIP_RETRIES" \
    --no-build-isolation \
    -e .
RUN jlpm install

COPY --chown=$NB_UID:$NB_GID jupyterlab-official-thermal-examples/setup.py \
    jupyterlab-official-thermal-examples/package.json \
    jupyterlab-official-thermal-examples/.yarnrc.yml \
    /src/jupyterlab-official-thermal-examples/
COPY --chown=$NB_UID:$NB_GID jupyterlab-official-thermal-examples/jupyterlab_official_thermal_examples/__init__.py /src/jupyterlab-official-thermal-examples/jupyterlab_official_thermal_examples/__init__.py
WORKDIR /src/jupyterlab-official-thermal-examples
RUN pip install \
    --index-url "$PIP_INDEX_URL" \
    --extra-index-url "$PIP_EXTRA_INDEX_URL" \
    --timeout "$PIP_DEFAULT_TIMEOUT" \
    --retries "$PIP_RETRIES" \
    --no-build-isolation \
    -e .
RUN jlpm install

COPY --chown=$NB_UID:$NB_GID jupyterlab-training-platform/setup.py \
    jupyterlab-training-platform/package.json \
    jupyterlab-training-platform/package-lock.json \
    jupyterlab-training-platform/.yarnrc.yml \
    /src/jupyterlab-training-platform/
COPY --chown=$NB_UID:$NB_GID jupyterlab-training-platform/jupyterlab_training_platform/__init__.py /src/jupyterlab-training-platform/jupyterlab_training_platform/__init__.py
WORKDIR /src/jupyterlab-training-platform
RUN pip install \
    --index-url "$PIP_INDEX_URL" \
    --extra-index-url "$PIP_EXTRA_INDEX_URL" \
    --timeout "$PIP_DEFAULT_TIMEOUT" \
    --retries "$PIP_RETRIES" \
    --no-build-isolation \
    -e .
RUN npm ci

# Copy source code directory (requires nbgrader and jupyterlab folders in build context)
COPY --chown=$NB_UID:$NB_GID nbgrader /src/nbgrader
COPY --chown=$NB_UID:$NB_GID jupyterlab /src/jupyterlab
COPY --chown=$NB_UID:$NB_GID jupyterlab-thermal-design /src/jupyterlab-thermal-design
COPY --chown=$NB_UID:$NB_GID jupyterlab-simulation-platform /src/jupyterlab-simulation-platform
COPY --chown=$NB_UID:$NB_GID jupyterlab-param-binding /src/jupyterlab-param-binding
COPY --chown=$NB_UID:$NB_GID jupyterlab-official-thermal-examples /src/jupyterlab-official-thermal-examples
COPY --chown=$NB_UID:$NB_GID jupyterlab-training-platform /src/jupyterlab-training-platform
COPY --chown=$NB_UID:$NB_GID logo /src/logo

# Install custom jupyterlab first 
WORKDIR /src/jupyterlab
RUN cp /src/logo/simlab-favicon.svg packages/ui-components/style/icons/jupyter/jupyter-favicon.svg && \
    cp /src/logo/simlab-logo.svg packages/ui-components/style/icons/jupyter/jupyter.svg && \
    cp /src/logo/simlab-logo.svg packages/ui-components/style/icons/jupyter/jupyterlab-wordmark.svg && \
    cp /src/logo/simlab-notebook.svg packages/ui-components/style/icons/filetype/notebook.svg && \
    cp /src/logo/simlab-folder.svg packages/ui-components/style/icons/filetype/folder.svg && \
    cp /src/logo/simlab-folder-favorite.svg packages/ui-components/style/icons/filetype/folder-favorite.svg && \
    cp /src/logo/simlab-file.svg packages/ui-components/style/icons/filetype/file.svg
RUN git config --global init.defaultBranch main && \
    git init && \
    git config --global user.email "a@b.com" && \
    git config --global user.name "A" && \
    git add . && \
    git commit -m "init"
RUN pip install \
    --index-url "$PIP_INDEX_URL" \
    --extra-index-url "$PIP_EXTRA_INDEX_URL" \
    --timeout "$PIP_DEFAULT_TIMEOUT" \
    --retries "$PIP_RETRIES" \
    --no-build-isolation \
    -e .
RUN jlpm install
RUN jlpm run build
    
# Install custom nbgrader
WORKDIR /src/nbgrader
RUN pip install \
    --index-url "$PIP_INDEX_URL" \
    --extra-index-url "$PIP_EXTRA_INDEX_URL" \
    --timeout "$PIP_DEFAULT_TIMEOUT" \
    --retries "$PIP_RETRIES" \
    --no-build-isolation \
    -e .
RUN jlpm install && \
    jlpm run build && \
    jupyter labextension develop . --overwrite && \
    cd nbgrader/server_extensions/formgrader/static && jlpm install

# Install thermal design plugin
WORKDIR /src/jupyterlab-thermal-design
RUN jlpm install && \
    jlpm run build && \
    jupyter labextension develop . --overwrite

# Install template-based simulation platform plugin
WORKDIR /src/jupyterlab-simulation-platform
RUN jlpm install && \
    jlpm run build && \
    jupyter labextension develop . --overwrite

# Install generic parameter binding plugin
WORKDIR /src/jupyterlab-param-binding
RUN jlpm install && \
    jlpm run build && \
    jupyter labextension develop . --overwrite

# Install official thermal modeling examples plugin
WORKDIR /src/jupyterlab-official-thermal-examples
RUN jlpm install && \
    jlpm run build && \
    jupyter labextension develop . --overwrite

# Install public training tutorial platform plugin
WORKDIR /src/jupyterlab-training-platform
RUN npm ci && \
    npm run build && \
    jupyter labextension develop . --overwrite

# Fail the image build if source edits were not compiled into the prebuilt
# labextension bundles that JupyterLab actually loads.
RUN grep -R "作业评测平台" /src/nbgrader/nbgrader/labextension/static/*.js >/dev/null && \
    grep -R "mainMenu.addMenu(nbgraderMenu, true, { rank: 8 })" /src/nbgrader/nbgrader/labextension/static/*.js >/dev/null && \
    grep -R "mainMenu.addMenu(simulationMenu, true, { rank: 5 })" /src/jupyterlab-simulation-platform/jupyterlab_simulation_platform/labextension/static/*.js >/dev/null && \
    grep -R "mainMenu.addMenu(thermalMenu, true, { rank: 6 })" /src/jupyterlab-thermal-design/jupyterlab_thermal_design/labextension/static/*.js >/dev/null && \
    grep -R "mainMenu.addMenu(officialMenu, true, { rank: 7 })" /src/jupyterlab-official-thermal-examples/jupyterlab_official_thermal_examples/labextension/static/*.js >/dev/null && \
    grep -R "学习课程" /src/jupyterlab-training-platform/jupyterlab_training_platform/labextension/static/*.js >/dev/null && \
    grep -R "管理员工具" /src/jupyterlab-training-platform/jupyterlab_training_platform/labextension/static/*.js >/dev/null && \
    grep -R "课程管理" /src/jupyterlab-training-platform/jupyterlab_training_platform/labextension/static/*.js >/dev/null && \
    grep -R "上传媒体资源" /src/jupyterlab-training-platform/jupyterlab_training_platform/labextension/static/*.js >/dev/null && \
    grep -R "插入媒体资源" /src/jupyterlab-training-platform/jupyterlab_training_platform/labextension/static/*.js >/dev/null && \
    grep -R "评论" /src/jupyterlab-training-platform/jupyterlab_training_platform/labextension/static/*.js >/dev/null

# Overwrite the official SVG icons with our custom ones BEFORE building
RUN cp /src/jupyterlab/packages/ui-components/style/icons/jupyter/jupyter.svg \
       /opt/conda/share/jupyter/lab/static/ 2>/dev/null || true && \
    cp /src/jupyterlab/packages/ui-components/style/icons/jupyter/jupyter-favicon.svg \
       /opt/conda/share/jupyter/lab/static/ 2>/dev/null || true && \
    cp /src/jupyterlab/packages/ui-components/style/icons/jupyter/jupyterlab-wordmark.svg \
       /opt/conda/share/jupyter/lab/static/ 2>/dev/null || true && \
    cp /src/jupyterlab/packages/ui-components/style/icons/filetype/notebook.svg \
       /opt/conda/share/jupyter/lab/static/ 2>/dev/null || true && \
    cp /src/jupyterlab/packages/ui-components/style/icons/filetype/folder.svg \
       /opt/conda/share/jupyter/lab/static/ 2>/dev/null || true && \
    cp /src/jupyterlab/packages/ui-components/style/icons/filetype/folder-favorite.svg \
       /opt/conda/share/jupyter/lab/static/ 2>/dev/null || true && \
    cp /src/jupyterlab/packages/ui-components/style/icons/filetype/file.svg \
       /opt/conda/share/jupyter/lab/static/ 2>/dev/null || true

# Also overwrite in the installed npm package so `jupyter lab build` picks them up
RUN UICOMP_DIR=$(find /opt/conda -path "*/labextensions/@jupyterlab/ui-components" -type d 2>/dev/null | head -1) && \
    if [ -n "$UICOMP_DIR" ]; then \
      cp /src/jupyterlab/packages/ui-components/style/icons/jupyter/jupyter.svg \
         "$UICOMP_DIR/static/" 2>/dev/null || true; \
      cp /src/jupyterlab/packages/ui-components/style/icons/jupyter/jupyter-favicon.svg \
         "$UICOMP_DIR/static/" 2>/dev/null || true; \
      cp /src/jupyterlab/packages/ui-components/style/icons/jupyter/jupyterlab-wordmark.svg \
         "$UICOMP_DIR/static/" 2>/dev/null || true; \
      cp /src/jupyterlab/packages/ui-components/style/icons/filetype/notebook.svg \
         "$UICOMP_DIR/static/" 2>/dev/null || true; \
      cp /src/jupyterlab/packages/ui-components/style/icons/filetype/folder.svg \
         "$UICOMP_DIR/static/" 2>/dev/null || true; \
      cp /src/jupyterlab/packages/ui-components/style/icons/filetype/folder-favorite.svg \
         "$UICOMP_DIR/static/" 2>/dev/null || true; \
      cp /src/jupyterlab/packages/ui-components/style/icons/filetype/file.svg \
         "$UICOMP_DIR/static/" 2>/dev/null || true; \
    fi

# Rebuild JupyterLab to bake in the custom nbgrader extensions + custom icons
WORKDIR /home/jovyan
RUN jupyter lab build --splice-source --minimize=False && \
    grep -R "#8A2387" /opt/conda/share/jupyter/lab/static/*.js >/dev/null && \
    grep -R "width: '24px'" /opt/conda/share/jupyter/lab/static/*.js >/dev/null

# Ensure logo/icon redirect targets still exist after the build rewrites static assets.
RUN cp /src/logo/simlab-favicon.svg /opt/conda/share/jupyter/lab/static/jupyter-favicon.svg && \
    cp /src/logo/simlab-logo.svg /opt/conda/share/jupyter/lab/static/jupyter.svg && \
    cp /src/logo/simlab-logo.svg /opt/conda/share/jupyter/lab/static/jupyterlab-wordmark.svg && \
    cp /src/logo/simlab-notebook.svg /opt/conda/share/jupyter/lab/static/notebook.svg && \
    cp /src/logo/simlab-folder.svg /opt/conda/share/jupyter/lab/static/folder.svg && \
    cp /src/logo/simlab-folder-favorite.svg /opt/conda/share/jupyter/lab/static/folder-favorite.svg && \
    cp /src/logo/simlab-file.svg /opt/conda/share/jupyter/lab/static/file.svg

# Fix: jupyter lab build may produce an empty static/package.json
# Copy the staging package.json to static so _get_static_data() can parse it
RUN STATIC_PKG="/opt/conda/share/jupyter/lab/static/package.json" && \
    if [ ! -s "$STATIC_PKG" ]; then \
      cp /src/jupyterlab/jupyterlab/staging/package.json "$STATIC_PKG" 2>/dev/null || \
      echo '{"name":"@jupyterlab/application-top","version":"4.2.7"}' > "$STATIC_PKG"; \
    fi

# Copy custom translation settings
RUN cp /src/jupyterlab/packages/translation-extension/schema/plugin.json \
       /opt/conda/share/jupyter/lab/schemas/@jupyterlab/translation-extension/plugin.json 2>/dev/null || true

# Copy settings overrides (Chinese locale as default and disabled extensions)
RUN mkdir -p /opt/conda/share/jupyter/lab/settings && \
    echo '{ \
      "@jupyterlab/translation-extension:plugin": { "locale": "zh_CN" }, \
      "@jupyterlab/extensionmanager-extension:plugin": { "enabled": false }, \
      "@jupyterlab/toc-extension:registry": { "enabled": false } \
    }' > /opt/conda/share/jupyter/lab/settings/overrides.json

# Keep the SimLab logo visible in the JupyterLab Light & Dark themes
RUN for theme in "theme-light-extension" "theme-dark-extension"; do \
      for THEME_CSS in $(find /opt/conda/share/jupyter/ -name "index.css" -path "*/$theme/*"); do \
        echo '#jp-MainLogo svg { display: block !important; width: 28px; height: 28px; margin: auto 4px; cursor: pointer; flex-shrink: 0; } #jp-MainLogo::before { content: none !important; display: none !important; } #jp-MainLogo { display: flex !important; align-items: center !important; width: 33px !important; min-width: 33px !important; } #jp-MainLogo button { background: transparent !important; border: none !important; padding: 0 !important; }' >> "$THEME_CSS"; \
      done; \
    done

CMD ["start-singleuser.sh"]
