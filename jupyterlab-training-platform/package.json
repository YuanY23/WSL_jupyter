{
  "name": "jupyterlab-training-platform",
  "version": "0.1.0",
  "description": "Public training tutorial browser, admin manager, and tutorial comments for SimLab",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "simlab",
    "training"
  ],
  "license": "BSD-3-Clause",
  "author": {
    "name": "Yuan",
    "email": "yuan@example.com"
  },
  "files": [
    "lib/**/*.{d.ts,js,js.map,json}",
    "style/**/*.{css,js,json}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "scripts": {
    "build": "npm run build:lib && npm run build:labextension:dev",
    "build:prod": "npm run clean && npm run build:lib:prod && npm run build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "test": "npm run build:lib && node tests/api-client.test.js && node tests/admin-api-client.test.js && node tests/tutorial-metadata.test.js && node tests/copy-tutorial.test.js && node tests/comment-visibility.test.js"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.2.7",
    "@jupyterlab/apputils": "^4.3.7",
    "@jupyterlab/coreutils": "^6.2.7",
    "@jupyterlab/mainmenu": "^4.2.7",
    "@jupyterlab/notebook": "^4.2.7",
    "@jupyterlab/services": "^7.2.7",
    "@lumino/widgets": "^2.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.2.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5",
    "typescript": "~5.0.4"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab_training_platform/labextension"
  }
}
