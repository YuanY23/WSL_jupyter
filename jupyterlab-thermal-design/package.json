{
    "name": "jupyterlab-thermal-design",
    "version": "0.1.0",
    "description": "Thermal Design Simulation",
    "keywords": [
        "jupyter",
        "jupyterlab",
        "jupyterlab-extension"
    ],
    "homepage": "https://github.com/yuan/jupyterlab-thermal-design",
    "bugs": {
        "url": "https://github.com/yuan/jupyterlab-thermal-design/issues"
    },
    "license": "BSD-3-Clause",
    "author": {
        "name": "Yuan",
        "email": "yuan@example.com"
    },
    "files": [
        "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
        "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "style": "style/index.css",
    "repository": {
        "type": "git",
        "url": "https://github.com/yuan/jupyterlab-thermal-design.git"
    },
    "scripts": {
        "build": "npm run build:lib && npm run build:labextension:dev",
        "build:prod": "npm run clean && npm run build:lib:prod && npm run build:labextension",
        "build:labextension": "jupyter labextension build .",
        "build:labextension:dev": "jupyter labextension build --development True .",
        "build:lib": "tsc --sourceMap",
        "build:lib:prod": "tsc",
        "clean": "npm run clean:lib",
        "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
        "clean:labextension": "rimraf jupyterlab_thermal_design/labextension jupyterlab_thermal_design/_version.py",
        "clean:all": "npm run clean:lib && npm run clean:labextension && rimraf node_modules yarn.lock",
        "install:extension": "npm run build",
        "watch": "run-p watch:src watch:labextension",
        "watch:src": "tsc -w --sourceMap",
        "watch:labextension": "jupyter labextension watch ."
    },
    "dependencies": {
        "@jupyterlab/application": "^4.2.7",
        "@jupyterlab/apputils": "^4.3.7",
        "@jupyterlab/cells": "^4.2.7",
        "@jupyterlab/coreutils": "^6.2.7",
        "@jupyterlab/docregistry": "^4.2.7",
        "@jupyterlab/filebrowser": "^4.2.7",
        "@jupyterlab/mainmenu": "^4.2.7",
        "@jupyterlab/notebook": "^4.2.7",
        "@jupyterlab/rendermime": "^4.2.7",
        "@jupyterlab/services": "^7.2.7",
        "@jupyterlab/ui-components": "^4.2.7",
        "@lumino/coreutils": "^2.1.2",
        "@lumino/messaging": "^2.0.1",
        "@lumino/signaling": "^2.1.2",
        "@lumino/widgets": "^2.3.1",
        "echarts": "^6.0.0",
        "echarts-for-react": "^3.0.6",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@jupyterlab/builder": "^4.2.7",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "npm-run-all": "^4.1.5",
        "rimraf": "^5.0.5",
        "typescript": "~5.0.4"
    },
    "sideEffects": [
        "style/*.css",
        "style/index.js"
    ],
    "styleModule": "style/index.js",
    "publishConfig": {
        "access": "public"
    },
    "jupyterlab": {
        "extension": true,
        "outputDir": "jupyterlab_thermal_design/labextension"
    }
}
